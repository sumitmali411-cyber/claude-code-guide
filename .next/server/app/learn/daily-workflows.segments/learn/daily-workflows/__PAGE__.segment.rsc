15:T6bb,<span style=<span style="color:#86efac">"color:#586e75"</span>># Analyze logs in real-time</span>
tail -f app.log | <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"alert me if you see any anomalies"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Review changed files for security issues</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>git</span> diff main --name-only | <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"review these for security issues"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Save analysis to file</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>cat</span> build-error.txt | <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"explain the root cause"</span> &gt; analysis.txt

<span style=<span style="color:#86efac">"color:#586e75"</span>># Structured JSON output for scripts</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"list all API endpoints"</span> --output-format json | jq <span style="color:#86efac">'.[]'</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Lint-style code review in CI</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"you are a linter. check for typos in changed files vs main.   report filename:line and description only"</span>d:["$","$L3",null,{"delay":100,"children":[["$","h2",null,{"children":"Unix-Style Piping"}],["$","p",null,{"children":"Claude Code is composable — pipe data in, pipe structured output out:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L14",null,{"text":"# Analyze logs in real-time\ntail -f app.log | claude -p \"alert me if you see any anomalies\"\n\n# Review changed files for security issues\ngit diff main --name-only | claude -p \"review these for security issues\"\n\n# Save analysis to file\ncat build-error.txt | claude -p \"explain the root cause\" > analysis.txt\n\n# Structured JSON output for scripts\nclaude -p \"list all API endpoints\" --output-format json | jq '.[]'\n\n# Lint-style code review in CI\nclaude -p \"you are a linter. check for typos in changed files vs main.   report filename:line and description only\""}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"$15"}}]}]]}]]}]
16:T4ec,<span style=<span style="color:#86efac">"color:#586e75"</span>># Start Claude in a new isolated worktree (new branch + directory)</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --worktree feature-auth

<span style=<span style="color:#86efac">"color:#586e75"</span>># Start another session on a different task simultaneously</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --worktree bugfix-payment

<span style=<span style="color:#86efac">"color:#586e75"</span>># Auto-generate a name</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --worktree

<span style=<span style="color:#86efac">"color:#586e75"</span>># Worktrees are created at .<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span>/worktrees/&lt;name&gt;/</span>
<span style=<span style="color:#86efac">"color:#586e75"</span>># Add to .gitignore:</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>echo</span> <span style="color:#86efac">".<span style="</span>color:#7c3aed;font-weight:600<span style="color:#86efac">">claude</span>/worktrees/"</span> &gt;&gt; .gitignoree:["$","$L3",null,{"delay":100,"children":[["$","h2",null,{"children":"Parallel Sessions with Git Worktrees"}],["$","p",null,{"children":"Work on multiple tasks simultaneously without conflicts — each session gets its own isolated copy of the codebase:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L14",null,{"text":"# Start Claude in a new isolated worktree (new branch + directory)\nclaude --worktree feature-auth\n\n# Start another session on a different task simultaneously\nclaude --worktree bugfix-payment\n\n# Auto-generate a name\nclaude --worktree\n\n# Worktrees are created at .claude/worktrees/<name>/\n# Add to .gitignore:\necho \".claude/worktrees/\" >> .gitignore"}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"$16"}}]}]]}],["$","div",null,{"className":"tip-block","children":"When you exit a worktree session with no changes, it cleans up automatically. With changes, Claude asks whether to keep or remove the branch."}]]}]
17:T480,<span style=<span style="color:#86efac">"color:#586e75"</span>># Continue most recent session</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --continue

<span style=<span style="color:#86efac">"color:#586e75"</span>># Pick from recent sessions</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --resume

<span style=<span style="color:#86efac">"color:#586e75"</span>># Resume by name</span>
