13:T51c,<span style=<span style="color:#86efac">"color:#586e75"</span>># Add an MCP server interactively</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> mcp add

<span style=<span style="color:#86efac">"color:#586e75"</span>># Add a specific server (example: filesystem)</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> mcp add filesystem -- <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>npx</span> -y @modelcontextprotocol/server-filesystem /path

<span style=<span style="color:#86efac">"color:#586e75"</span>># Add GitHub MCP</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> mcp add github -- <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>npx</span> -y @modelcontextprotocol/server-github

<span style=<span style="color:#86efac">"color:#586e75"</span>># List configured servers</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> mcp list

<span style=<span style="color:#86efac">"color:#586e75"</span>># Remove a server</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> mcp remove &lt;name&gt;a:["$","$L3",null,{"delay":100,"children":[["$","h2",null,{"children":"Add MCP Servers"}],["$","p",null,{"children":"Use the CLI to add any MCP server:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L12",null,{"text":"# Add an MCP server interactively\nclaude mcp add\n\n# Add a specific server (example: filesystem)\nclaude mcp add filesystem -- npx -y @modelcontextprotocol/server-filesystem /path\n\n# Add GitHub MCP\nclaude mcp add github -- npx -y @modelcontextprotocol/server-github\n\n# List configured servers\nclaude mcp list\n\n# Remove a server\nclaude mcp remove <name>"}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"$13"}}]}]]}],["$","p",null,{"children":"Or configure directly in settings:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"text-xs font-mono","style":{"color":"#64748b"},"children":"~/.claude/settings.json"}],["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"json"}]]}],["$","$L12",null,{"text":"{\n  \"mcpServers\": {\n    \"github\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-github\"],\n      \"env\": {\n        \"GITHUB_PERSONAL_ACCESS_TOKEN\": \"$GITHUB_TOKEN\"\n      }\n    },\n    \"postgres\": {\n      \"command\": \"npx\",\n      \"args\": [\"-y\", \"@modelcontextprotocol/server-postgres\"],\n      \"env\": {\n        \"POSTGRES_CONNECTION_STRING\": \"postgresql://localhost/mydb\"\n      }\n    }\n  }\n}"}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":"$L14"}]]}]]}]
