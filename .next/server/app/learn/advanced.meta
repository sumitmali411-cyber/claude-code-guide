{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/learn/layout,_N_T_/learn/advanced/layout,_N_T_/learn/advanced/page,_N_T_/learn/advanced"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/learn/advanced/__PAGE__",
    "/learn/advanced",
    "/learn",
    "/_index",
    "/_head"
  ]
}