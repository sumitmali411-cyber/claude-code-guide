{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/learn/layout,_N_T_/learn/memory/layout,_N_T_/learn/memory/page,_N_T_/learn/memory"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/learn/memory/__PAGE__",
    "/learn/memory",
    "/learn",
    "/_index",
    "/_head"
  ]
}