24:T722,<span style=<span style="color:#86efac">"color:#586e75"</span>># One-off query</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"explain what this project does"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Structured JSON output for scripts</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"list all API endpoints"</span> --output-format json

<span style=<span style="color:#86efac">"color:#586e75"</span>># Streaming for real-time processing</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"analyze this log file"</span> --output-format stream-json

<span style=<span style="color:#86efac">"color:#586e75"</span>># Pipe data in</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>cat</span> build-error.txt | <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"explain the root cause concisely"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># In Plan Mode (read-only, safe for CI analysis)</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --permission-mode plan -p <span style="color:#86efac">"check for security issues in changed files"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Skip all permission prompts (use in sandboxed environments only)</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> --dangerously-skip-permissions -p <span style="color:#86efac">"fix all lint errors"</span>17:["$","$L13",null,{"delay":100,"children":[["$","h2",null,{"children":"Non-Interactive (Headless) Mode"}],["$","p",null,{"children":"Run Claude in CI pipelines, pre-commit hooks, or scripts without an interactive session:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L14",null,{"text":"# One-off query\nclaude -p \"explain what this project does\"\n\n# Structured JSON output for scripts\nclaude -p \"list all API endpoints\" --output-format json\n\n# Streaming for real-time processing\nclaude -p \"analyze this log file\" --output-format stream-json\n\n# Pipe data in\ncat build-error.txt | claude -p \"explain the root cause concisely\"\n\n# In Plan Mode (read-only, safe for CI analysis)\nclaude --permission-mode plan -p \"check for security issues in changed files\"\n\n# Skip all permission prompts (use in sandboxed environments only)\nclaude --dangerously-skip-permissions -p \"fix all lint errors\""}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"$24"}}]}]]}]]}]
18:["$","$L13",null,{"delay":100,"children":[["$","h2",null,{"children":"CI/CD with GitHub Actions"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"text-xs font-mono","style":{"color":"#64748b"},"children":".github/workflows/claude-review.yml"}],["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"yaml"}]]}],["$","$L14",null,{"text":"name: Claude Code Review\n\non:\n  pull_request:\n    types: [opened, synchronize]\n\njobs:\n  review:\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Claude PR Review\n        uses: anthropics/claude-code-action@beta\n        with:\n          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}\n          # Claude will review the PR and post comments automatically"}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"<span style=\"color:<span style=\"color:#586e75\">#818cf8\">name</span>: Claude Code Review</span>\n\n<span style=\"color:<span style=\"color:#586e75\">#818cf8\">on</span>:</span>\n  pull_request:\n    types: [opened, synchronize]\n\n<span style=\"color:<span style=\"color:#586e75\">#818cf8\">jobs</span>:</span>\n  review:\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      pull-requests: write\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n\n      - name: Claude PR Review\n        uses: anthropics/claude-code-action@beta\n        with:\n          anthropic_api_key: ${{ secrets.ANTHROPIC_API_KEY }}\n          <span style=\"color:#586e75\"># Claude will review the PR and post comments automatically</span>"}}]}]]}],["$","p",null,{"children":["Claude Code also has official GitLab CI/CD integration via ",["$","code",null,{"children":"anthropics/claude-code-gitlab"}],"."]}]]}]
25:T4fa,<span style=<span style="color:#86efac">"color:#586e75"</span>># Step 1: Get list of files to process</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"list all Python files that use the old requests library"</span> &gt; files.txt

<span style=<span style="color:#86efac">"color:#586e75"</span>># Step 2: Loop Claude across each file</span>
while IFS= read -r file; do
  <span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"migrate $file from requests to httpx. Return OK or FAIL."</span> \
    --allowedTools <span style="color:#86efac">"Edit,Bash(<span style="</span>color:#7c3aed;font-weight:600<span style="color:#86efac">">git</span> commit *)"</span> &
done &lt; files.txt

wait
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>echo</span> <span style="color:#86efac">"All done"</span>

<span style=<span style="color:#86efac">"color:#586e75"</span>># Step 3: Review with structured output</span>
<span style=<span style="color:#86efac">"color:#7c3aed;font-weight:600"</span>>claude</span> -p <span style="color:#86efac">"summarize all changes made"</span> --output-format json | jq .19:["$","$L13",null,{"delay":100,"children":[["$","h2",null,{"children":"Fan Out Across Files"}],["$","p",null,{"children":"For large migrations, loop Claude across hundreds of files in parallel:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L14",null,{"text":"# Step 1: Get list of files to process\nclaude -p \"list all Python files that use the old requests library\" > files.txt\n\n# Step 2: Loop Claude across each file\nwhile IFS= read -r file; do\n  claude -p \"migrate $file from requests to httpx. Return OK or FAIL.\" \\\n    --allowedTools \"Edit,Bash(git commit *)\" &\ndone < files.txt\n\nwait\necho \"All done\"\n\n# Step 3: Review with structured output\nclaude -p \"summarize all changes made\" --output-format json | jq ."}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"$25"}}]}]]}],["$","div",null,{"className":"warning-block mt-3","children":["Use ",["$","code",null,{"children":"--allowedTools"}]," to restrict what Claude can do in unattended mode. Only use ",["$","code",null,{"children":"--dangerously-skip-permissions"}]," in a sandboxed environment without internet access."]}]]}]
