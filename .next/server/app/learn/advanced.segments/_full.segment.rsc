d:["$","div",null,{"className":"flex flex-col lg:flex-row gap-8","children":[["$","div",null,{"className":"flex-1 min-w-0 content","children":[["$","$L13",null,{"children":[["$","h2",null,{"children":"Custom Sub-agents"}],["$","p",null,{"children":"Sub-agents run in their own isolated context with their own tools. Useful for research (keeps your main context clean) and specialized review tasks."}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":[["$","span",null,{"className":"text-xs font-mono","style":{"color":"#64748b"},"children":".claude/agents/security-reviewer.md"}],["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"markdown"}]]}],["$","$L14",null,{"text":"---\nname: security-reviewer\ndescription: Reviews code for security vulnerabilities. Use when reviewing PRs\n  or asking about security issues.\ntools: Read, Grep, Glob, Bash\nmodel: opus\n---\n\nYou are a senior security engineer. Review code for:\n- Injection vulnerabilities (SQL, XSS, command injection)\n- Authentication and authorization flaws\n- Secrets or credentials accidentally committed\n- Insecure data handling and storage\n- Dependency vulnerabilities\n\nProvide specific line references and suggested fixes for each issue found."}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"<span style=\"color:#38bdf8\">---\nname: security-reviewer\ndescription: Reviews code for security vulnerabilities. Use when reviewing PRs\n  or asking about security issues.\ntools: Read, Grep, Glob, Bash\nmodel: opus\n---</span>\n\nYou are a senior security engineer. Review code for:\n- Injection vulnerabilities (SQL, XSS, command injection)\n- Authentication and authorization flaws\n- Secrets or credentials accidentally committed\n- Insecure data handling and storage\n- Dependency vulnerabilities\n\nProvide specific line references and suggested fixes for each issue found."}}]}]]}],["$","$L15",null,{"title":"Use sub-agents","prompts":["use a subagent to review this code for security issues","use subagents to investigate how our auth system handles token refresh","have a subagent analyze our API endpoints for inconsistencies","/agents"]}]]}],["$","$L13",null,{"delay":100,"children":[["$","h2",null,{"children":"Agent Teams"}],["$","p",null,{"children":"Spawn multiple Claude instances that work in parallel on different parts of a task, coordinated by a lead agent:"}],["$","div",null,{"className":"code-block my-4","children":[["$","div",null,{"className":"code-block-header","children":[["$","div",null,{"className":"flex items-center gap-2","children":["$undefined",["$","span",null,{"className":"text-xs px-2 py-0.5 rounded","style":{"background":"rgba(124,58,237,0.12)","color":"#a78bfa","fontFamily":"monospace"},"children":"bash"}]]}],["$","$L14",null,{"text":"# /batch is the easiest way to run agent teams\n/batch migrate all API handlers in src/api/ from Express 4 to Express 5\n\n# Claude will:\n# 1. Research the codebase\n# 2. Break work into 5-30 independent units\n# 3. Show you the plan for approval\n# 4. Spawn one agent per unit, each in its own worktree\n# 5. Each agent opens a separate PR when done"}]]}],["$","pre",null,{"className":"overflow-x-auto","style":{"padding":"16px","margin":0,"fontFamily":"var(--font-mono, 'JetBrains Mono', monospace)","fontSize":"0.85rem","lineHeight":"1.65","color":"#c9d1d9","background":"var(--code-bg)"},"children":["$","code",null,{"dangerouslySetInnerHTML":{"__html":"<span style=<span style=\"color:#86efac\">\"color:#586e75\"</span>># /batch is the ea