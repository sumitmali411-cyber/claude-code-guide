1b:["$","$L13",null,{"delay":100,"children":[["$","h2",null,{"children":"Auto Memory"}],["$","p",null,{"children":"Auto memory is on by default. Claude saves notes as it works — build commands it discovers, your correction patterns, debugging insights — without you writing anything."}],["$","p",null,{"children":["Stored at ",["$","code",null,{"children":"~/.claude/projects/<project>/memory/MEMORY.md"}],". The first 200 lines load into every session."]}],["$","div",null,{"className":"rounded-xl p-5 my-4","style":{"background":"var(--card)","border":"1px solid rgba(255,255,255,0.07)"},"children":[["$","div",null,{"className":"font-semibold text-sm mb-3","style":{"color":"#e2e8f0"},"children":"How to control auto memory"}],["$","div",null,{"className":"space-y-3","children":[["$","div","View memory files",{"className":"flex items-center justify-between gap-4","children":[["$","span",null,{"className":"text-sm","style":{"color":"#94a3b8"},"children":"View memory files"}],["$","code",null,{"className":"text-xs px-2 py-1 rounded","style":{"background":"rgba(124,58,237,0.1)","color":"#c4b5fd","fontFamily":"monospace"},"children":"/memory"}]]}],["$","div","Tell Claude to remember something",{"className":"flex items-center justify-between gap-4","children":[["$","span",null,{"className":"text-sm","style":{"color":"#94a3b8"},"children":"Tell Claude to remember something"}],["$","code",null,{"className":"text-xs px-2 py-1 rounded","style":{"background":"rgba(124,58,237,0.1)","color":"#c4b5fd","fontFamily":"monospace"},"children":"say \"always use pnpm, not npm\""}]]}],["$","div","Disable auto memory",{"className":"flex items-center justify-between gap-4","children":[["$","span",null,{"className":"text-sm","style":{"color":"#94a3b8"},"children":"Disable auto memory"}],["$","code",null,{"className":"text-xs px-2 py-1 rounded","style":{"background":"rgba(124,58,237,0.1)","color":"#c4b5fd","fontFamily":"monospace"},"children":"{\"autoMemoryEnabled\": false} in settings"}]]}],["$",